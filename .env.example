# Copy this file to .env and put your OpenAI key here
OPENAI_API_KEY=sk-...

# Optional
# LLM_MODEL=gpt-4.1
# EMBEDDING_MODEL=text-embedding-3-large
# JUDGE_MODEL=gpt-4.1
# FAST_MODEL=gpt-4.1-mini
# WEAK_RETRIEVAL_DISTANCE=1.0     # run: python -m app.calibrate

# Debug logger (optional) - one log file per session in logs/
# DEBUG_LOG_DIR=logs
# DEBUG_LOG_CONSOLE_LEVEL=INFO    # DEBUG = also print full prompts/contexts in the terminal, OFF = file only
# DEBUG_LOG_MAX_CHARS=0           # 0 = never cut long texts in the log
# DEBUG_LOG_ENABLED=1             # 0 = turn the debug logger off
